DISCORD_TOKEN=your-discord-bot-token-here
# admin discord user IDs (comma-separated) — they can !run !up !zip etc.
ADMIN_IDS=123456789012345678
# same model this repo was built with. any `opencode models` id works.
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
# the zai api key from opencode auth (bot writes it to auth file on boot).
# NEVER commit the real .env — it is gitignored.
OPENCODE_API_KEY=paste-your-key-here
TASK_TIMEOUT=600
RUN_TIMEOUT=60
PREFIX=!
COOLDOWN_S=10
